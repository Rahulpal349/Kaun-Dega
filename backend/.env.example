# ==============================================================================
# KAUN DEGA BACKEND - PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Copy this file to .env on your production server and fill in the values.
# NEVER commit the actual .env file to version control.
# ==============================================================================

# Spring Profile
SPRING_PROFILES_ACTIVE=prod

# Server Port
PORT=8080

# CORS Configuration
# Comma-separated list of allowed frontend domains (e.g., https://kaundega.com,https://www.kaundega.com)
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com

# Database Connection
# Example: jdbc:postgresql://db-host:5432/kaundega?sslmode=require
DB_URL=jdbc:postgresql://your-db-host:5432/your-db-name
DB_USERNAME=your_production_db_user
DB_PASSWORD=your_super_secret_db_password

# Database Connection Pooling (Optional tuning)
DB_POOL_MAX=50
DB_POOL_MIN=5

# JWT Secret
# Generate a secure 256-bit (or larger) random string for signing JWT tokens.
# Do NOT use a dictionary word or short string.
JWT_SECRET=generate_a_secure_random_base64_string_here_that_is_at_least_32_bytes_long

# SSL/TLS Configuration (Optional, if terminating SSL directly in Spring Boot instead of an API Gateway/Nginx)
# SERVER_SSL_KEY_STORE=/path/to/keystore.p12
# SERVER_SSL_KEY_STORE_PASSWORD=keystore_password
